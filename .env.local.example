# ─── Application ───
APP_URL="https://idggov.tech"
NODE_ENV="production"

# ─── Gemini AI ───
GEMINI_API_KEY="your_gemini_api_key_here"

# ─── Database (Prisma) ───
# Leave empty for graceful fallback (forms work without persistence)
# Set to a real PostgreSQL URL for full persistence
DATABASE_URL="postgresql://user:password@host:5432/idg_db?schema=public"

# ─── Google reCAPTCHA ───
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your_recaptcha_site_key_here"
RECAPTCHA_SECRET_KEY="your_recaptcha_secret_key_here"

# ─── Google Analytics & Search Console ───
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your_google_site_verification_token"

# ─── Mailchimp Newsletter ───
MAILCHIMP_API_KEY="your_mailchimp_api_key_here-us19"
MAILCHIMP_LIST_ID="your_mailchimp_list_audience_id"
MAILCHIMP_SERVER_PREFIX="us19"
