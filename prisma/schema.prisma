generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Existing Models
// ──────────────────────────────────────────────

model ContactInquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  subject     String?
  problem     String?
  message     String?
  referenceId String   @unique
  createdAt   DateTime @default(now())
}

model CareerApplication {
  id            String   @id @default(cuid())
  name          String
  email         String
  position      String
  coverNote     String?
  resumeName    String?
  applicationId String   @unique
  createdAt     DateTime @default(now())
}

// ──────────────────────────────────────────────
// Production Models
// ──────────────────────────────────────────────

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  locale    String   @default("ku")
  status    String   @default("PENDING") // PENDING, REVIEWED, RESOLVED, ARCHIVED
  createdAt DateTime @default(now())

  @@index([status])
  @@index([locale])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  locale       String   @default("ku")
  subscribedAt DateTime @default(now())
  status       String   @default("ACTIVE") // ACTIVE, UNSUBSCRIBED

  @@index([status])
  @@index([locale])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  locale    String   @default("ku")
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([locale])
  @@index([createdAt])
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  locale      String    @default("ku")
  author      String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  featured    Boolean   @default(false)

  @@index([locale])
  @@index([publishedAt])
}
